# ───────────────────────────────────────────────────────────
# Hibi — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repositorio.
# ───────────────────────────────────────────────────────────

# ── acmsy: runtime ─────────────────────────────────────────
# El servidor (acmsy) inyecta PORT en producción; en local
# usamos 3100 desde el script `dev`.
PORT=3000
HOST=0.0.0.0

# ── acmsy: base de datos ───────────────────────────────────
# acmsy inyecta estas vars en producción al conectar la BD
# elegida. En local, dejar vacías si todavía no usas BD.
DB_ENGINE=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DATABASE_URL=

# ── Supabase (opcional, para auth/datos) ───────────────────
# supabase.com → Project Settings → API
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth (se configura dentro de Supabase) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Groq (IA, console.groq.com → API Keys) ─────────────────
GROQ_API_KEY=

# ── App ────────────────────────────────────────────────────
NUXT_PUBLIC_APP_URL=http://localhost:3100
NUXT_PUBLIC_APP_NAME=Hibi
