# ───────────────────────────────────────────────────────────
# Hibi — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repositorio.
# En producción (acmsy) casi todas se inyectan solas (useAcmsyAuth:true).
# ───────────────────────────────────────────────────────────

# ── acmsy: runtime ─────────────────────────────────────────
# acmsy inyecta PORT en producción; en local el script `dev` usa 3100.
PORT=3000
HOST=0.0.0.0

# ── Base de datos (Postgres) ───────────────────────────────
# En prod la inyecta acmsy al conectar la BD `db-hibi`.
# En dev, un Postgres local (Docker):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hibi

# ── Sesión / auth ──────────────────────────────────────────
# Cadena larga aleatoria propia de esta app (estable). Genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Login con Google (cliente compartido "acmsy web") ──────
# Mismas claves para todas las apps de acmsy. Registra el redirect
# https://hibi.acmsy.com/auth/google/callback en Google Cloud Console
# (y en dev http://localhost:3100/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Correo (Resend) — para recuperación de contraseña ──────
RESEND_API_KEY=
MAIL_FROM=noreply@acmsy.com

# ── Origen detrás del proxy (OAuth/CSRF/redirects) ─────────
# En prod: https://hibi.acmsy.com. En dev: http://localhost:3100.
ORIGIN=http://localhost:3100
ACMSY_SUBDOMAIN=hibi

# ── IA local de acmsy (Ollama vía gateway acmsy-ai) ────────
# En prod las inyecta acmsy. Preferente el gateway con API key;
# alternativa: Ollama directo. En dev usa tu Ollama local.
AI_API_URL=
AI_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
