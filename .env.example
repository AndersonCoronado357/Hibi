# ───────────────────────────────────────────────────────────
# Hibi — variables de entorno
# Copia este archivo a `.env` y rellena los valores.
# NUNCA subas `.env` al repositorio.
# ───────────────────────────────────────────────────────────

# Supabase  (supabase.com → Project Settings → API)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth  (se configura dentro de Supabase, útil tenerlo aquí)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq  (console.groq.com → API Keys — free tier generoso)
GROQ_API_KEY=

# App
NUXT_PUBLIC_APP_URL=http://localhost:3100
NUXT_PUBLIC_APP_NAME=Hibi
